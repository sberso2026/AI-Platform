# Supabase — copy to apps/web/.env.local
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (API routes, background jobs)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
COMMERCE_SCHEDULER_SECRET=your-commerce-scheduler-secret

# AI Services (Phase 2)
# OPENAI_API_KEY=
# PLATFORM_EMBEDDING_API_KEY=
# PLATFORM_EMBEDDING_BASE_URL=https://api.openai.com/v1
# PLATFORM_EMBEDDING_MODEL=text-embedding-3-small
# PLATFORM_EMBEDDING_REGION=provider-default
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
# AZURE_DOCUMENT_INTELLIGENCE_KEY=
# DOCLING_SERVICE_URL=
# ANTHROPIC_API_KEY=
# GOOGLE_AI_API_KEY=

# Observability (Phase 2)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# OTEL_EXPORTER_OTLP_ENDPOINT=

# Microsoft Teams / Graph (Phase 6C-3E live staging only — set as GitHub/Vercel secrets, never commit values)
# PI_TEAMS_GRAPH_MODE=live
# PI_TEAMS_LIVE_CERT_ENABLED=true
# PI_TEAMS_TENANT_ID=
# PI_TEAMS_CLIENT_ID=
# PI_TEAMS_CLIENT_SECRET=
