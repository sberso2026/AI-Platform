{
  "name": "@rtb/customer-administration-certification",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:unit": "cross-env CUSTOMER_ADMIN_CERTIFICATION=1 vitest run src/administration-certification.ts src/http-certification.ts src/uninstall-contract.test.ts src/certification-regression.test.ts",
    "test:regression": "cross-env CUSTOMER_ADMIN_CERTIFICATION=1 vitest run src/certification-regression.test.ts",
    "test:administration": "cross-env CUSTOMER_ADMIN_CERTIFICATION=1 vitest run src/administration-certification.ts",
    "test:http": "cross-env CUSTOMER_ADMIN_CERTIFICATION=1 vitest run src/http-certification.ts src/http-live-certification.ts src/uninstall-http-certification.ts",
    "test:growth": "cross-env CUSTOMER_ADMIN_CERTIFICATION=1 vitest run src/growth-credit-certification.ts",
    "test:e2e": "cross-env CUSTOMER_ADMIN_CERTIFICATION=1 playwright test playwright/flows-a-p.spec.ts playwright/flow-n-uninstall.spec.ts",
    "test:a11y": "cross-env CUSTOMER_ADMIN_CERTIFICATION=1 playwright test playwright/accessibility.spec.ts",
    "test:responsive": "cross-env CUSTOMER_ADMIN_CERTIFICATION=1 playwright test playwright/responsive.spec.ts",
    "verify-hosted-schema": "tsx src/verify-hosted-schema.ts",
    "provision": "tsx scripts/provision-fixtures.ts",
    "teardown": "tsx scripts/teardown-fixtures.ts",
    "certify": "tsx scripts/run-certification.ts",
    "release-check": "tsx scripts/release-check.ts",
    "verify-release-artifact": "tsx scripts/verify-release-artifact.ts",
    "ci-preflight": "tsx scripts/ci-preflight.ts"
  },
  "dependencies": {
    "@rtb/platform-commerce": "workspace:*",
    "@rtb/platform-core": "workspace:*",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.29",
    "cross-env": "^7.0.3",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  }
}
