{
  "name": "@rtb/project-intelligence-certification",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ci-preflight": "tsx src/ci-preflight.ts",
    "certify": "tsx scripts/run-certification.ts",
    "certify:providers": "tsx scripts/run-provider-certification.ts",
    "update-fixture-checksums": "tsx scripts/update-fixture-checksums.ts",
    "provision": "tsx scripts/provision.ts",
    "verify-fixture": "tsx scripts/verify-fixture.ts",
    "cleanup": "tsx scripts/cleanup.ts",
    "test:unit": "vitest run src/gates.test.ts src/build-identity.test.ts src/http/nested-error-contract.test.ts src/http/entitlement-error-codes.test.ts src/playwright-positive-path-regression.test.ts src/project-intelligence-domain.test.ts src/fixtures/validate-fixture-readiness.test.ts src/documents/",
    "test:documents": "vitest run src/documents/",
    "test:rls": "vitest run src/rls/",
    "test:http": "vitest run src/http/nested-error-contract.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:documents": "playwright test playwright/documents.spec.ts",
    "test:e2e:a11y": "playwright test playwright/documents.spec.ts -g \"landmarks on documents|responsive documents\"",
    "verify-hosted-schema": "vitest run src/hosted-schema.test.ts"
  },
  "dependencies": {
    "@rtb/project-intelligence": "workspace:*",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.29",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  }
}
