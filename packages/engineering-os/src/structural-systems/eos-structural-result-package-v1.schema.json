{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eos-structural-result-package-v1",
  "title": "EOS_STRUCTURAL_RESULT_PACKAGE_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packageFormat",
    "schemaVersion",
    "packageId",
    "createdAt",
    "completeness",
    "producer",
    "provider",
    "source",
    "model",
    "run",
    "capabilities",
    "mappingExpectation",
    "objectMappingExpectation",
    "loadCases",
    "loadCombinations",
    "providerObjects",
    "results",
    "warnings"
  ],
  "properties": {
    "packageFormat": { "const": "EOS_STRUCTURAL_RESULT_PACKAGE" },
    "schemaVersion": { "const": "1" },
    "packageId": { "type": "string" },
    "createdAt": { "type": "string" },
    "completeness": { "enum": ["COMPLETE", "PARTIAL"] },
    "producer": { "type": "object", "additionalProperties": false, "required": ["producerId", "producerName"] },
    "provider": { "type": "object", "additionalProperties": false, "required": ["providerId", "providerName", "providerVersion"] },
    "source": { "type": "object", "additionalProperties": false, "required": ["sourceName", "sourceVersion", "sourceTimestamp"] },
    "model": { "type": "object", "additionalProperties": false, "required": ["providerModelId", "modelVersion", "analysisType"] },
    "run": { "type": "object", "additionalProperties": false, "required": ["providerRunId", "providerRunState", "providerConvergenceState", "runVersion", "runTimestamp"] },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "mappingExpectation": { "type": "object", "additionalProperties": false, "required": ["mappingManifestId", "mappingManifestVersion"] },
    "objectMappingExpectation": { "type": "object", "additionalProperties": false, "required": ["objectMappingId", "objectMappingVersion"] },
    "loadCases": { "type": "array" },
    "loadCombinations": { "type": "array" },
    "providerObjects": { "type": "array" },
    "results": { "type": "array" },
    "warnings": { "type": "array" },
    "extensions": { "type": "object", "description": "Non-governing metadata. Ignored for adapter, mapping, project, profile, and result authority." }
  }
}
