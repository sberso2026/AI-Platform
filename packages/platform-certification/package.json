{
  "name": "@rtb/platform-certification",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "cross-env PLATFORM_CERTIFICATION=1 vitest run",
    "test:unit": "cross-env PLATFORM_CERTIFICATION=1 vitest run src",
    "test:e2e": "cross-env PLATFORM_CERTIFICATION=1 playwright test",
    "test:a11y": "cross-env PLATFORM_CERTIFICATION=1 playwright test playwright/accessibility.spec.ts",
    "test:responsive": "cross-env PLATFORM_CERTIFICATION=1 playwright test playwright/responsive.spec.ts",
    "provision": "tsx scripts/provision-fixtures.ts",
    "teardown": "tsx scripts/cleanup-fixtures.ts",
    "certify": "tsx scripts/run-certification.ts",
    "ci-preflight": "tsx scripts/ci-preflight.ts"
  },
  "dependencies": {
    "@rtb/platform-commerce": "workspace:*",
    "@rtb/platform-core": "workspace:*",
    "@rtb/platform-kernel": "workspace:*",
    "@rtb/project-intelligence": "workspace:*",
    "@rtb/reference-os": "workspace:*",
    "@rtb/types": "workspace:*",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.29",
    "cross-env": "^7.0.3",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  }
}
