# Vercel environment template for rtb-ai-platform (root: apps/web)
# Names and placeholders only. Never put real secrets in this file.
# Copy names into the Vercel project. Obtain values from the sources in
# docs/deployment/vercel-env-audit.md. Do not bulk-import local .env.local files.

# --- REQUIRED_PUBLIC (Vercel: Production + Preview; Development if used) ---
NEXT_PUBLIC_SUPABASE_URL=<supabase-eos-project-url>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-eos-anon-key>
NEXT_PUBLIC_APP_URL=https://eos-pilot.rtbea.com.au

# --- REQUIRED_SERVER_SECRET (Vercel: Production + Preview; encrypted) ---
SUPABASE_SERVICE_ROLE_KEY=<supabase-eos-service-role-key>
COMMERCE_AUTH_SECRET=<hmac-secret-not-the-code-default>
COMMERCE_SCHEDULER_SECRET=<scheduler-bearer-secret>

# --- OPTIONAL public ---
NEXT_PUBLIC_EOS_DEPLOYMENT_PROFILE=ESSENTIAL

# --- OPTIONAL server (Engineering AI Director chat; same key family as embeddings) ---
PLATFORM_LLM_API_KEY=<openai-or-leave-unset>
PLATFORM_LLM_BASE_URL=https://api.openai.com/v1
PLATFORM_LLM_MODEL=gpt-4o-mini
PLATFORM_LLM_PROVIDER=
OPENAI_API_KEY=<openai-or-leave-unset>
PLATFORM_EMBEDDING_API_KEY=<prefer-over-openai-or-leave-unset>
PLATFORM_EMBEDDING_BASE_URL=https://api.openai.com/v1
PLATFORM_EMBEDDING_MODEL=text-embedding-3-small
PLATFORM_EMBEDDING_REGION=provider-default
PLATFORM_EMBEDDING_PROVIDER=
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=<azure-or-leave-unset>
AZURE_DOCUMENT_INTELLIGENCE_KEY=<azure-or-leave-unset>
AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-layout
AZURE_DOCUMENT_INTELLIGENCE_OCR_MODEL=prebuilt-read

# --- OPTIONAL Teams / Graph (not required for Engineering OS core pilot) ---
PI_TEAMS_GRAPH_MODE=
PI_TEAMS_WEBHOOK_BASE_URL=
PI_TEAMS_TENANT_ID=
PI_TEAMS_CLIENT_ID=
PI_TEAMS_CLIENT_SECRET=
PI_TEAMS_WEBHOOK_CLIENT_STATE=
PI_TEAMS_TEST_TENANT_LABEL=
PI_TEAMS_LIVE_CERT_ENABLED=
PI_TEAMS_PROVIDER_ENABLED=

# --- OPTIONAL runtime flags (defaults are safe for hosted postgres) ---
SUPABASE_PROJECT_REF=wcydlhqiqdwgoaqrlget
RTB_ENFORCE_PRIVILEGED_MFA=
ASSET_INTELLIGENCE_REPOSITORY_ADAPTER=postgres
PROJECT_CONTROLS_REPOSITORY_ADAPTER=postgres
DIGITAL_TWIN_REPOSITORY_ADAPTER=postgres
ENGINEERING_MODEL_REPOSITORY_ADAPTER=postgres
EXECUTION_HOST_REPOSITORY_ADAPTER=postgres

# --- Do not set on Vercel (platform-injected) ---
# VERCEL_URL
# VERCEL_ENV
# VERCEL_REGION
# VERCEL_GIT_COMMIT_SHA
# VERCEL_GIT_COMMIT_REF
# VERCEL_DEPLOYMENT_ID
# NODE_ENV

# --- Do not copy from local files ---
# CERT_USER_PASSWORD
# RTB_TEST_BASE_URL
# SUPABASE_TEST_URL
# SUPABASE_TEST_ANON_KEY
# VERCEL_OIDC_TOKEN
# PROJECT_INTELLIGENCE_CERTIFICATION
# PI_PROVIDER_CERTIFICATION
# CUSTOMER_ADMIN_CERTIFICATION_TARGET
# ALLOW_PRODUCTION_CERTIFICATION
# SMTP_* (Auth mailer is configured in Supabase, not Vercel)
